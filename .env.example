# Copy to .env and fill in your real token.
# Get a token at https://stratz.com/api
STRATZ_API_TOKEN=

# Postgres connection strings. Local defaults match docker-compose.yml.
DATABASE_URL=postgresql+psycopg://dota_predictor:dota_predictor@localhost:5432/dota_predictor

# Dedicated test database -- deliberately separate from DATABASE_URL.
# DB-touching tests are skipped (not redirected to DATABASE_URL) when this
# is unset, so a test run can never accidentally hit dev/prod data.
TEST_DATABASE_URL=postgresql+psycopg://dota_predictor:dota_predictor@localhost:5432/dota_predictor_test

# Optional override for where the canonical analytical Parquet dataset
# (scripts/build_canonical_dataset.py) is written. Defaults to
# data/processed/ under the project root when unset.
# PROCESSED_DATA_DIR=data/processed
